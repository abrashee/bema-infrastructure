# Copy this file to env/.env.dev or env/.env.prod.
# Never commit real credentials or production secrets.

# Runtime profile
SPRING_PROFILES_ACTIVE=dev

# Shared database credentials
DB_USER=bema_admin
DB_PASSWORD=replace-with-a-strong-database-password

# Database names
USER_DB=bema_user_db
POLICY_DB=bema_policy_db
CLAIM_DB=bema_claim_db
IDENTITY_DB=bema_identity_db

# JWT
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
JWT_EXPIRATION=3600000

# Gateway security
CORS_ALLOWED_ORIGIN=http://localhost:4200
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX_REQUESTS=300
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Identity brute-force protection
BRUTE_FORCE_MAX_FAILURES=5
BRUTE_FORCE_FAILURE_WINDOW_SECONDS=900
BRUTE_FORCE_LOCK_SECONDS=900

# Identity bootstrap — disabled unless explicitly enabled
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Claim service
CLAIM_LOG_LEVEL=info
WEBSOCKET_ORIGIN=http://localhost:4200

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-strong-grafana-password
